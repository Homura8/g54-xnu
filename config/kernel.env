# Kernel pipeline pins. Read by .github/workflows/kernel.yml and
# scripts/check_repo.py; every value is exact (no branches, no "latest").
#
# Line K0 = reproduce ruby-ios-bringup's 0195 kernel unchanged. A G54 patch in
# patches/ changes G54_PATCHSET_SHA256 and clears KERNEL_EXPECT_EXEC_DATA until
# a booted G54 kernel provides a new reference.

# Device-independent MediaTek/iOS 16 base: lky005/ruby-ios-bringup (MIT + APSL patches)
RUBY_REPO=https://github.com/lky005/ruby-ios-bringup.git
RUBY_SHA=1aaa883755e546726b2f3a49a3ad099d77de4e62
RUBY_PATCHSET_SHA256=a9cc0050432d4259f38c2e5431e0ac05eecf95c3a78324ad94f11283d8031983

# Its public baseline (sweet 0001-0079 lineage); fetched at build time, never vendored
BASE_REPO=https://github.com/MakrSas/ios-topaz.git
BASE_SHA=5095ac19dbdcf37b64b81fe443f4027ad51b84bf
BASELINE_MANIFEST_SHA256=829d759826607027bc4a1d9818b6dd4956a312a087217b6ce7e5ce31fa3ae910

# Build driver and Apple open source
DXB_REPO=https://github.com/blacktop/darwin-xnu-build
DXB_SHA=663906528d1cd5ea8fde7de6f16de73db9511549
MACOS_VERSION=13.5
APPLE_XNU_TAG=xnu-8796.141.3
KERNEL_CONFIG=DEVELOPMENT
MACHINE_CONFIG=SWEET
KERNEL_CPU=cortex-a55

# Toolchain: xnu-8796 needs Xcode 16.0's iig ABI; checked, not assumed
RUNNER_IMAGE=macos-15
XCODE_VERSION=16.0
XCODE_BUILD=16A242d

# Gates
# 0200-g54-early-framebuffer, 0201-g54-panic-reset (2026-11-12), 0202-g54-novatek-touch, 0203-g54-keys, 0204-g54-fb-no-debug-markers, 0205-g54-fb-alpha-blend, 0206-g54-noexec, 0207-g54-halt-restart (2026-11-13): record-only until a booted G54 kernel
# provides a new exec-data reference (docs/build.md).
G54_PATCHSET_SHA256=2f0ae19054eb0fbca7b9e690d4b4da89cc99668cf9a49566697033ce5914d7a9
KERNEL_EXPECT_EXEC_DATA=
