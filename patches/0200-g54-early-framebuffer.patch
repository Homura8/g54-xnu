G54 (MT6855): move the SWEET early framebuffer to the LK scanout buffer.

Ruby (MT6877) hard-codes its visible LK layer 0x7cdfc000, pitch 4352. On the
Moto G54 LK scans out OVL0 layer 1 at 0xfeac6000, pitch 4320 (read from the
display engine on the phone, g54-xnu docs/experiments E4). Updates the stage-0
band, the 32MB V=P Normal-NC block (0xfe000000), its final-TTBR1 alias offset
and the early console.

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 0273c4e..9df084e 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1843,7 +1843,7 @@ sweet_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x7c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = 0xfe000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
@@ -2190,7 +2190,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 
 #if defined(SWEET)
 	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
-	sweet_early_relocate(SWEET_EARLY_FB_VA + 0xdfc000);
+	sweet_early_relocate(SWEET_EARLY_FB_VA + 0xac6000);	/* G54: 0xfeac6000 in the 0xfe000000 block */
 #endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 4d42c9e..87c1ae7 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -514,11 +514,15 @@ LEXT(start_first_cpu)
 	mov		x21, #0
 
 #if defined(SWEET)
-	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x7cdfc000 + 2368 * 4352)
+	/*
+	 * Stage 0: white 64x32 band, no stack or page tables needed.
+	 * G54 (MT6855): LK scans out OVL0 layer 1 at 0xfeac6000, pitch 4320
+	 * (read from the display engine on the phone, g54-xnu experiment E4).
+	 */
+	MOV64	x0, (0xfeac6000 + 2368 * 4320)
 	mov		w1, #-1
 	mov		x2, #32
-	mov		x4, #4352
+	mov		x4, #4320
 Lsweet_mark_row:
 	mov		x3, #64
 	mov		x5, x0
@@ -683,10 +687,11 @@ Lkernelcache_base_found:
 	 * Splash framebuffer: one 32MB Normal-NC block in the EXISTING V=P
 	 * L2 table. Both framebuffer and RAM use L1 index 0; another call to
 	 * create_bootstrap_mapping would replace the RAM L2 table.
-	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
-	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
+	 * SWEET uses 16K pages: one L1 entry spans 64GB, so the G54 framebuffer
+	 * (0xfe000000 block) and RAM (0x140000000) share the first V=P L2 page,
+	 * bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x7c000000
+	MOV64	x10, 0xfe000000
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 36fea71..73fa257 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -11,11 +11,11 @@
 #include <stdint.h>
 #include <kern/misc_protos.h>
 
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x7cdfc000;
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0xfeac6000;	/* G54 OVL0 L1 */
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
 #define EARLY_HEIGHT 2400u
-#define EARLY_STRIDE (4352u / 4)
+#define EARLY_STRIDE (4320u / 4)
 #define EARLY_SCALE 2u
 #define EARLY_CELL_W (8u * EARLY_SCALE)
 #define EARLY_CELL_H (16u * EARLY_SCALE)
