+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -251,16 +251,29 @@ SweetCPU::startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr)
 	return KERN_SUCCESS;
 }
 
+/*
+ * G54: power the calling CPU down with PSCI CPU_OFF (it comes back through
+ * startCPU's CPU_ON). XNU quiesces every secondary CPU on shutdown and
+ * restart; the old panic here made "slide to power off" panic the phone.
+ */
 void
 SweetCPU::quiesceCPU(void)
 {
-	panic("SWEET CPU: CPU quiesce is not implemented");
+	register uint64_t x0 __asm__("x0") = 0x84000002ULL;     /* PSCI CPU_OFF */
+	__asm__ volatile("dsb sy\n\tsmc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	for (;;) {
+		__asm__ volatile("wfi");
+	}
 }
 
 void
 SweetCPU::haltCPU(void)
 {
-	panic("SWEET CPU: CPU halt/suspend is not implemented");
+	for (;;) {
+		__asm__ volatile("dsb sy\n\twfi");
+	}
 }
 
