 OSDefineMetaClassAndStructors(SweetPlatformExpert, IODTPlatformExpert);
 
+/*
+ * G54 halt/restart (PE_halt_restart was NULL: shutdown spun forever after the
+ * CPU quiesce). Halt = PSCI SYSTEM_OFF. Restart = PSCI SYSTEM_RESET after
+ * clearing the MT6855 watchdog reboot-mode bits (TOPRGU 0x1c007000 + 0x24,
+ * low nibble) that the g54-xnu loader set to "bootloader", so a user restart
+ * boots normally instead of entering Fastboot. Panic paths are untouched
+ * (g54panicreset still lands in Fastboot).
+ */
+extern int (*PE_halt_restart)(unsigned int type);
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+static volatile uint32_t *sweet_toprgu;
+
+static void
+sweet_psci_system(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	__asm__ volatile("dsb sy\n\tsmc #0" : "+r"(x0) : :
+	    "x1", "x2", "x3", "x4", "x5", "x6", "x7", "x8", "x9", "x10",
+	    "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+}
+
+static int
+sweet_halt_restart(unsigned int type)
+{
+	if (type == kPEHaltCPU) {
+		IOLog("SWEET: power off (PSCI SYSTEM_OFF)\n");
+		sweet_psci_system(0x84000008ULL);
+	} else if (type == kPERestartCPU) {
+		if (sweet_toprgu != NULL) {
+			sweet_toprgu[0x24 / 4] = sweet_toprgu[0x24 / 4] & ~0xfu;   /* as the loader writes it, no key */
+		}
+		IOLog("SWEET: restart (PSCI SYSTEM_RESET)\n");
+		sweet_psci_system(0x84000009ULL);
+	} else {
+		return -1;
+	}
+	return -1;      /* PSCI returned: report failure */
+}
