+/*
+ * Diagnostic FairPlayIOKit stub for G54 / SWEET, gated on g54fpstub=1.
+ *
+ * fairplayd.H2 exits before bootstrap_check_in if IOServiceGetMatchingServices
+ * for com_apple_driver_FairPlayIOKit finds 0 services, leaving LaunchDaemons
+ * (checkpointd -> Photos, locationd -> Settings Date & Time) blocked on
+ * synchronous MIG calls to com.apple.fairplayd.H2. Registering the service and
+ * logging calls shows which selectors fairplayd.H2 requires next.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+class com_apple_driver_FairPlayIOKit : public IOService {
+	OSDeclareDefaultStructors(com_apple_driver_FairPlayIOKit);
+
+public:
+	IOService *probe(IOService *provider, SInt32 *score) APPLE_KEXT_OVERRIDE;
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(com_apple_driver_FairPlayIOKit, IOService);
+
+IOService *
+com_apple_driver_FairPlayIOKit::probe(IOService *provider, SInt32 *score)
+{
+	int on = 0;
+
+	/* Decline in probe (no instance is started) unless g54fpstub=1. */
+	if (!PE_parse_boot_argn("g54fpstub", &on, sizeof(on)) || on != 1) {
+		return NULL;
+	}
+	return IOService::probe(provider, score);
+}
+
+bool
+com_apple_driver_FairPlayIOKit::start(IOService *provider)
+{
+	if (!IOService::start(provider)) {
+		return false;
+	}
+	setProperty(kIOUserClientClassKey, "com_apple_driver_FairPlayIOKitUserClient");
+	registerService();
+	IOLog("SWEET FP: com_apple_driver_FairPlayIOKit registered (diag stub)\n");
+	return true;
+}
+
+class com_apple_driver_FairPlayIOKitUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(com_apple_driver_FairPlayIOKitUserClient);
+
+public:
+	IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target,
+	    void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(com_apple_driver_FairPlayIOKitUserClient, IOUserClient);
+
+IOReturn
+com_apple_driver_FairPlayIOKitUserClient::clientClose(void)
+{
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+com_apple_driver_FairPlayIOKitUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args,
+    __unused IOExternalMethodDispatch *dispatch, __unused OSObject *target,
+    __unused void *reference)
+{
+	uint32_t in_scalars = args->scalarInputCount;
+	uint32_t in_struct = args->structureInputDescriptor != NULL ?
+	    (uint32_t)args->structureInputDescriptor->getLength() : args->structureInputSize;
+	uint32_t out_scalars = args->scalarOutputCount;
+	uint32_t out_struct = args->structureOutputDescriptor != NULL ?
+	    (uint32_t)args->structureOutputDescriptor->getLength() : args->structureOutputSize;
+	uint64_t arg0 = in_scalars > 0 ? args->scalarInput[0] : 0;
+	char name[32];
+
+	IOReturn ret = kIOReturnUnsupported;
+
+	proc_selfname(name, sizeof(name));
+	IOLog("SWEET FP: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n",
+	    name, selector, arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	return ret;
+}
+#endif /* SWEET */
