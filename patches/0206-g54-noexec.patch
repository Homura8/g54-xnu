G54: boot-arg g54noexec=name1,name2 refuses to exec the named binaries.

Daemons that cannot work on this hardware (bluetoothd, fairplayd.H2 on the
G54) crash and are relaunched by launchd forever; each launch costs seconds
of CPU on the Cortex-A55s (g54-xnu E29 previous-boot log). The check sits in
SWEET's existing per-exec log hook and matches p_name exactly. Off unless
the boot-arg is set. A refusal fails the exec like the neighbouring platform
check (EACCES with an OS_REASON_EXEC reason, which the failure path asserts).

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 68612db..ddea3c7 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -6222,6 +6222,42 @@ exec_check_permissions(struct image_params *imgp)
 	if (!vnode_isreg(vp)) {
 		return EACCES;
 	}
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * G54: boot-arg g54noexec=name1,name2 refuses matching binaries before
+	 * image activation so posix_spawn/execve returns EACCES cleanly without
+	 * SIGKILL, CRASH console noise, or waking ReportCrash.
+	 */
+	{
+		static char g54_noexec[128];
+		static int g54_noexec_state;     /* 0 unread, 1 none, 2 set */
+		static int g54_noexec_logs;
+		if (g54_noexec_state == 0) {
+			g54_noexec_state = PE_parse_boot_arg_str("g54noexec", g54_noexec,
+			    sizeof(g54_noexec)) && g54_noexec[0] ? 2 : 1;
+		}
+		if (g54_noexec_state == 2 && imgp->ip_ndp != NULL &&
+		    imgp->ip_ndp->ni_cnd.cn_nameptr != NULL) {
+			const char *nm = imgp->ip_ndp->ni_cnd.cn_nameptr;
+			size_t nl = (size_t)imgp->ip_ndp->ni_cnd.cn_namelen;
+			const char *c = g54_noexec;
+			while (*c) {
+				const char *e = c;
+				while (*e && *e != ',') {
+					e++;
+				}
+				if ((size_t)(e - c) == nl && nl && strncmp(c, nm, nl) == 0) {
+					if (g54_noexec_logs < 8) {
+						g54_noexec_logs++;
+						printf("exec %.*s refused (g54noexec)\n", (int)nl, nm);
+					}
+					return EACCES;
+				}
+				c = *e ? e + 1 : e;
+			}
+		}
+	}
+#endif
 
 	/* Get the file attributes that we will be using here and elsewhere */
 	VATTR_INIT(vap);
