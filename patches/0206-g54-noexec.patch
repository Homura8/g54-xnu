G54: boot-arg g54noexec=name1,name2 refuses to exec the named binaries.

Daemons that cannot work on this hardware (bluetoothd, fairplayd.H2 on the
G54) crash and are relaunched by launchd forever; each launch costs seconds
of CPU on the Cortex-A55s (g54-xnu E29 previous-boot log). The check sits in
SWEET's existing per-exec log hook and matches p_name exactly. Off unless
the boot-arg is set.

diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
index 68612db..632ade0 100644
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -7412,6 +7412,36 @@ process_signature(proc_t p, struct image_params *imgp)
 				goto done;
 			}
 #if defined(ARM64_BOARD_CONFIG_SWEET)
+			/*
+			 * G54: boot-arg g54noexec=name1,name2 refuses these binaries.
+			 * Daemons that cannot work on this hardware (bluetoothd,
+			 * fairplayd.H2) crash and are relaunched forever, each launch
+			 * costing seconds of CPU on the A55s.
+			 */
+			{
+				static char g54_noexec[128];
+				static int g54_noexec_state;     /* 0 unread, 1 none, 2 set */
+				if (g54_noexec_state == 0) {
+					g54_noexec_state = PE_parse_boot_arg_str("g54noexec", g54_noexec,
+					    sizeof(g54_noexec)) && g54_noexec[0] ? 2 : 1;
+				}
+				if (g54_noexec_state == 2) {
+					size_t nl = strlen(p->p_name);
+					const char *c = g54_noexec;
+					while (*c) {
+						const char *e = c;
+						while (*e && *e != ',') {
+							e++;
+						}
+						if ((size_t)(e - c) == nl && nl && strncmp(c, p->p_name, nl) == 0) {
+							printf("exec %s refused (g54noexec)\n", p->p_name);
+							error = EPERM;
+							goto done;
+						}
+						c = *e ? e + 1 : e;
+					}
+				}
+			}
 			/* SWEET runs every iOS binary this way: one short line per exec. */
 			printf("exec %s\n", p->p_name);
 #else
